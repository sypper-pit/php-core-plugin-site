Options -Indexes

# Block sensitive file extensions
<FilesMatch "\.(json|log|lock|txt|md|sh|htaccess|env|git.*)$">
    Require all denied
</FilesMatch>

# Block PHP files execution except index.php
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>

# Route requests to index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
