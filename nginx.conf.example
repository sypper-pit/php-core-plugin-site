server {
    listen 80;
    server_name localhost;
    root /var/www/html;
    index index.php;

    server_tokens off;
    client_max_body_size 4m;

    # Protect private directories
    location ~ ^/(core|data|plugins|libs/sleekdb)/ {
        deny all;
        return 404;
    }

    # Protect sensitive files
    location ~ \.(json|log|lock|txt|md|sh|htaccess|env|git) {
        deny all;
        return 404;
    }

    # Allow static assets and vendor-js
    location ~ ^/(assets|libs/vendor-js)/ {
        try_files $uri =404;
    }

    # Route PHP requests strictly to index.php
    location ~ \.php$ {
        if ($request_uri !~ "^/index\.php") {
            return 404;
        }
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}
