{
  "manifest_version": 3,
  "name": "Perplexity OpenCode Gateway & Agent",
  "version": "1.0.0",
  "description": "Chrome extension acting as an autonomous API gateway to Perplexity.ai for OpenCode with rate limit tracking & OpenAI compatible endpoint.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://www.perplexity.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Perplexity Gateway"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
